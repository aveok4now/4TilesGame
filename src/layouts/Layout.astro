---
import {AUTHOR_NAME, SITE_DESCRIPTION} from "../config.ts"
import BaseHead from "../components/server/BaseHead.astro"
import Body from "../components/server/Body.astro"
import Footer from "../components/server/Footer.astro"

interface Props {
    title: string;
}

const {title} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${AUTHOR_NAME} - ${title}`}
			description={SITE_DESCRIPTION}
		/>
	</head>
	<Body>
		<slot />
	</Body>
    <Footer />
</html>